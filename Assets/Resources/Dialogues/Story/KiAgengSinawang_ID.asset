  m_Script: {fileID: 11500000, guid: 6ee7b598c5ab3ff4ca2f90f31e9bc917, type: 3}
  m_Name: KiAgengSinawang_ID
  m_EditorClassIdentifier: 
  npcName: Ki Ageng Sinawang
  dialogueDescription: Pemimpin padepokan, guru spiritual Menak Sopal
  dialogueEntries:
  - speakerName: Ki Ageng Sinawang
    dialogueText: Ah, Menak Sopal. Kekeringan ini membuat kita dan para warga dalam
      selimut kegelisahan. Bercengkeramalah dengan warga desa, mereka membutuhkan
      bantuanmu...
    availableTimesOfDay: 0100000000000000
    isRepeatable: 0
    requiredFlags:
    - story_started
    flagsToAdd:
    - story_started
    - first_contact
    flagsToRemove: []
    hasChoices: 0
    choices: []
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 0
    pauseAfterDialogue: 0
  - speakerName: Ki Ageng Sinawang
    dialogueText: Penderitaan warga disekitar kita memberatkan hatimu, muridku. Terkadang
      perbuatan mulia yang terbesar memerlukan pengorbanan yang besar pula.
    availableTimesOfDay: 010000000000000002000000
    isRepeatable: 0
    requiredFlags:
    - water_crisis_discovered
    flagsToAdd: []
    flagsToRemove: []
    hasChoices: 1
    choices:
    - choiceText: Ingin membantu
      requiredFlags: []
      availableTimesOfDay: 
      isRepeatable: 1
      flagsToAdd:
      - asked_permission_water_project
      flagsToRemove: []
      targetDialogueIndex: 3
      response:
        speakerName: Menak Sopal
        responseText: Ki Ageng, atas izinmu, izinkanlah aku untuk membantu tentang
          masalah ini. Diriku terpanggil untuk membantu tentang masalah ini
        conversationBubbleSprite: {fileID: 0}
        pauseAfterResponse: 0
        continueToNext: 1
        nextDialogueIndex: 3
      questToStart: gather_construction_helpers
      questToComplete: 
      objectiveToComplete: receive_permission
      questForObjective: seek_guru_guidance
      isImportantChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 0
    pauseAfterDialogue: 0
  - speakerName: Ki Ageng Sinawang
    dialogueText: Kamu telah belajar bahwa bahkan niat mulia pun dapat menyebabkan
      rasa sakit. Tapi dari rasa sakit ini, pemahaman tumbuh. Desa kini memiliki
      air, dan kamu memiliki kebijaksanaan.
    availableTimesOfDay: 00000000010000000200000003000000
    isRepeatable: 0
    requiredFlags:
    - story_completed
    - reconciliation_complete
    flagsToAdd: []
    flagsToRemove: []
    hasChoices: 0
    choices: []
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 1
    pauseAfterDialogue: 0
  - speakerName: Ki Ageng Sinawang
    dialogueText: Belas kasihanmu menghormati ajaran kita, muridku. Bergegaslah,
      restuku membersamai niat baikmu.
    availableTimesOfDay: 00000000010000000200000003000000
    isRepeatable: 0
    requiredFlags:
    - asked_permission_water_project
    flagsToAdd: []
    flagsToRemove: []
    hasChoices: 0
    choices: []
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 1
    pauseAfterDialogue: 0
  - speakerName: Ki Ageng Sinawang
    dialogueText: Menak Sopal, perihal apa yang menimpamu. Sehingga wajahmu terlihat
      begitu murung sedari gerbang padepokan kita?
    availableTimesOfDay: 00000000010000000200000003000000
    isRepeatable: 0
    requiredFlags:
    - talked_with_witness
    flagsToAdd: []
    flagsToRemove: []
    hasChoices: 0
    choices:
    - choiceText: Menjelaskan Situasi
      requiredFlags: []
      availableTimesOfDay: 
      isRepeatable: 0
      flagsToAdd:
      - hearing_situation
      flagsToRemove: []
      targetDialogueIndex: 5
      response:
        speakerName: Menak Sopal
        responseText: Jadi seperti ini guru, kami telah berhasil membangun dam untuk
          membendung air agar dapat digunakan oleh warga sekitar dan juga padepokan.
          Namun entah mengapa, dam ini selalu hancur berkali kali ketika kami selesai
          membangunnya. Aku sungguh frustasi guru...
        conversationBubbleSprite: {fileID: 0}
        pauseAfterResponse: 0
        continueToNext: 1
        nextDialogueIndex: 5
      questToStart: 
      questToComplete: 
      objectiveToComplete: 
      questForObjective: 
      isImportantChoice: 0
      choiceColor: {r: 0, g: 0, b: 0, a: 0}
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 1
    pauseAfterDialogue: 0
  - speakerName: Ki Ageng Sinawang
    dialogueText: Seperti itu rupanya. Agaknya terdapat kekuatan asing tak terlihat
      yang mengganggu niat baik kalian. Cobalah bertapa disekitar tempat yang kau
      bangun dam itu muridku. Persiapkanlah dirimu, hal ini memerlukan ketenangan
      dan kesiapan yang matang.
    availableTimesOfDay: 00000000010000000200000003000000
    isRepeatable: 0
    requiredFlags:
    - talked_with_witness
    flagsToAdd: []
    flagsToRemove: []
    hasChoices: 0
    choices:
    - choiceText: Menjelaskan Situasi
      requiredFlags: []
      availableTimesOfDay: 
      isRepeatable: 0
      flagsToAdd:
      - hearing_situation
      flagsToRemove: []
      targetDialogueIndex: 0
      response:
        speakerName: Menak Sopal
        responseText: Jadi seperti ini gurru, kami telah berhasil membangun dam untuk
          membendung air agar dapat digunakan oleh warga sekitar dan juga padepokan.
          Namun entah mengapa, dam ini selalu hancur berkali kali ketika kami selesai
          membangunnya. Aku sungguh frustasi guru...
        conversationBubbleSprite: {fileID: 0}
        pauseAfterResponse: 0
        continueToNext: 1
        nextDialogueIndex: 0
      questToStart: 
      questToComplete: 
      objectiveToComplete: 
      questForObjective: 
      isImportantChoice: 0
      choiceColor: {r: 0, g: 0, b: 0, a: 0}
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 1
    pauseAfterDialogue: 0
  - speakerName: Ki Ageng Sinawang
    dialogueText: Bagaimana muridku, apakah pertapaanmu menghasilkan sesuatu?
    availableTimesOfDay: 00000000010000000200000003000000
    isRepeatable: 0
    requiredFlags:
    - talk_ki_ageng
    flagsToAdd: []
    flagsToRemove: []
    hasChoices: 1
    choices:
    - choiceText: Menjelaskan Situasi
      requiredFlags: []
      availableTimesOfDay: 
      isRepeatable: 0
      flagsToAdd:
      - hearing_situation
      flagsToRemove: []
      targetDialogueIndex: 7
      response:
        speakerName: Menak Sopal
        responseText: Aku menemukan sesuatu yang menyebabkan hancurnya dam yang kami
          bangun berkali kali guru. Ternyata terdapat penunggu sungai yang mengingkan
          sesuatu dari kami, sebuah kepala gajah putih!
        conversationBubbleSprite: {fileID: 0}
        pauseAfterResponse: 0
        continueToNext: 1
        nextDialogueIndex: 0
      questToStart: 
      questToComplete: 
      objectiveToComplete: 
      questForObjective: 
      isImportantChoice: 0
      choiceColor: {r: 0, g: 0, b: 0, a: 0}
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 1
    pauseAfterDialogue: 0
  - speakerName: Ki Ageng Sinawang
    dialogueText: Hmm, gajah putih. Sebuah permintaan yang cukup sulit. Aku kenal
      dengan seseorang dari desa Krandon yang memilikinya. Namun aku tidak yakin
      ia akan memberikan gajah itu dengan begitu saja. Apakah tidak ada cara lain?
    availableTimesOfDay: 00000000010000000200000003000000
    isRepeatable: 0
    requiredFlags:
    - talk_ki_ageng
    flagsToAdd: []
    flagsToRemove: []
    hasChoices: 1
    choices:
    - choiceText: Berfikir
      requiredFlags: []
      availableTimesOfDay: 
      isRepeatable: 0
      flagsToAdd:
      - hearing_situation
      flagsToRemove: []
      targetDialogueIndex: -1
      response:
        speakerName: Menak Sopal
        responseText: Aku kurang tau guru. Ada baiknya aku pergi menemui penunggu
          sungai lagi untuk memastikannya.
        conversationBubbleSprite: {fileID: 0}
        pauseAfterResponse: 0
        continueToNext: 1
        nextDialogueIndex: 0
      questToStart: 
      questToComplete: 
      objectiveToComplete: 
      questForObjective: 
      isImportantChoice: 0
      choiceColor: {r: 0, g: 0, b: 0, a: 0}
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 1
    pauseAfterDialogue: 0
  greetings:
  - speakerName: Ki Ageng Sinawang
    dialogueText: Pagi, muridku
    availableTimesOfDay: 01000000
    isRepeatable: 1
    requiredFlags: []
    flagsToAdd: []
    flagsToRemove: []
    hasChoices: 0
    choices: []
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 0
    pauseAfterDialogue: 0
  - speakerName: Ki Ageng Sinawang
    dialogueText: Berlatihlah dengan sungguh sungguh nak
    availableTimesOfDay: 00000000
    isRepeatable: 1
    requiredFlags: []
    flagsToAdd: []
    flagsToRemove: []
    hasChoices: 0
    choices: []
