  npcName: Budi (Murid Padepokan)
  dialogueDescription: Murid yang mengamati fenomena aneh
  dialogueEntries:
  - speakerName: Budi (Murid Padepokan)
    dialogueText: Sekarang semua bahan meterial terkumpul, mari kita selesaikan bendungan
      ini, Menak Sopal!
    availableTimesOfDay: 000000000200000001000000
    isRepeatable: 0
    requiredFlags:
    - materials_collected
    flagsToAdd:
    - dam_dialog_built
    flagsToRemove: []
    hasChoices: 0
    choices: []
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 0
    pauseAfterDialogue: 0
  - speakerName: Budi (Murid Padepokan)
    dialogueText: Bendungan ini terus rusak! Ada sesuatu yang tidak wajar tentang
      ini. Aku melihat riak aneh di air saat bendungan runtuh.
    availableTimesOfDay: 000000000200000001000000
    isRepeatable: 0
    requiredFlags:
    - dam_broken
    flagsToAdd: []
    flagsToRemove: []
    hasChoices: 0
    choices: []
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 0
    pauseAfterDialogue: 0
  - speakerName: Budi (Murid Padepokan)
    dialogueText: Kabar berlalu cepat nak, dan aku disini siap untuk membantu niat
      baikmu!
    availableTimesOfDay: 000000000200000001000000
    isRepeatable: 0
    requiredFlags:
    - committed_to_help
    - guru_guidance_received
    flagsToAdd: []
    flagsToRemove: []
    hasChoices: 0
    choices: []
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 0
    pauseAfterDialogue: 0
  - speakerName: Budi (Murid Padepokan)
    dialogueText: Kalau tentang jurus, aku pasti akan memberitahumu nak. Tapi Gajah
      Putih?, aku bahkan pertama kali ini mendegarnya
    availableTimesOfDay: 0000000001000000
    isRepeatable: 1
    requiredFlags:
    - keberadaan_gajah_putih
    flagsToAdd: []
    flagsToRemove: []
    hasChoices: 0
    choices: []
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 0
    pauseAfterDialogue: 0
  greetings:
  - speakerName: Budi (Murid Padepokan)
    dialogueText: Pagi saudara seperguruanku!
    availableTimesOfDay: 01000000
    isRepeatable: 1
    requiredFlags: []
    flagsToAdd: []
    flagsToRemove: []
