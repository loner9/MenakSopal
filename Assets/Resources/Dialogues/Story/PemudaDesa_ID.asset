    flagsToRemove: []
    hasChoices: 0
    choices: []
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 0
    pauseAfterDialogue: 0
  - speakerName: Bayu
    dialogueText: Membangun dam untuk membendung air?. Tentu saja aku akan membantu
      Menak Sopal!. Lagipula bertani akhir akhir ini dengan keadaan seperti ini cukup
      menyulitkan bagiku!
    availableTimesOfDay: 0100000000000000
    isRepeatable: 0
    requiredFlags:
    - committed_to_help
    - guru_guidance_received
    flagsToAdd: []
    flagsToRemove: []
    hasChoices: 0
