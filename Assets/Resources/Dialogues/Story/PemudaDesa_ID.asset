  npcName: Bayu
  dialogueDescription: Pembantu energik, quest fisik, kegiatan desa
  dialogueEntries:
  - speakerName: Bayu
    dialogueText: Hey, kamu pasti Menak Sopal. Aku Bayu, petani yang baru saja datang
      di pemukiman ini. Senang berkenalan denganmu!
    availableTimesOfDay: 0100000000000000
    isRepeatable: 0
    requiredFlags: []
