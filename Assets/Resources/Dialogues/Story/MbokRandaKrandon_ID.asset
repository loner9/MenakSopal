%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6ee7b598c5ab3ff4ca2f90f31e9bc917, type: 3}
  m_Name: MbokRandaKrandon_ID
  m_EditorClassIdentifier: 
  npcName: Mbok Randa Krandon
  dialogueDescription: Pemilik gajah putih, mewakili konflik dan pemahaman akhir
  dialogueEntries:
  - speakerName: Mbok Randa Krandon
    dialogueText: Pemuda dari padepokan? Apa yang membawamu sejauh ini dari rumah,
      nak?
    availableTimesOfDay: 
    isRepeatable: 1
    requiredFlags:
    - arrived_desa_krandon
    hasChoices: 1
    choices:
    - choiceText: Saya datang mencari gajah putih Mbok
      requiredFlags: []
      availableTimesOfDay: 
      isRepeatable: 1
      flagsToAdd:
      - requested_elephant_directly
      flagsToRemove: []
      targetDialogueIndex: -1
      response:
        speakerName: Mbok Randa Krandon
        responseText: Gajahku? Itu permintaan yang aneh. Mengapa murid padepokan
          membutuhkan gajah berhargaku?
        conversationBubbleSprite: {fileID: 0}
        pauseAfterResponse: 0
        continueToNext: 1
        nextDialogueIndex: -1
      questToStart: 
      questToComplete: 
      objectiveToComplete: 
      questForObjective: 
      isImportantChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    - choiceText: Saya datang membawa salam dari Ki Ageng Sinawang
      requiredFlags: []
      availableTimesOfDay: 
      isRepeatable: 1
      flagsToAdd: []
      flagsToRemove: []
      targetDialogueIndex: -1
      response:
        speakerName: Mbok Randa Krandon
        responseText: Ah, Ki Ageng! Aku mengenalnya ketika dia masih guru muda. Orang
          baik. Apa yang dia butuhkan?
        conversationBubbleSprite: {fileID: 0}
        pauseAfterResponse: 0
        continueToNext: 1
        nextDialogueIndex: -1
      questToStart: 
      questToComplete: 
      objectiveToComplete: 
      questForObjective: 
      isImportantChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 0
    pauseAfterDialogue: 0
  - speakerName: Mbok Randa Krandon
    dialogueText: Kamu ingin meminjam gajah putihku? Selama tiga hari? Itu cukup
      tidak biasa... tapi Ki Ageng menjaminmu.
    availableTimesOfDay: 
    isRepeatable: 1
    requiredFlags:
    - explained_water_crisis
    hasChoices: 1
    choices:
    - choiceText: Saya berjanji akan mengembalikannya dengan selamat
      requiredFlags: []
      availableTimesOfDay: 
      isRepeatable: 1
      flagsToAdd:
      - promised_safe_return
      flagsToRemove: []
      targetDialogueIndex: -1
      response:
        speakerName: Mbok Randa Krandon
        responseText: Baiklah. Tapi jika ada bahaya yang menimpanya, padepokanmu
          akan bertanggung jawab. Tiga hari, tidak lebih.
        conversationBubbleSprite: {fileID: 0}
        pauseAfterResponse: 0
        continueToNext: 1
        nextDialogueIndex: -1
      questToStart: 
      questToComplete: 
      objectiveToComplete: 
      questForObjective: 
      isImportantChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    - choiceText: Bagaimana jika sesuatu terjadi pada gajah itu?
      requiredFlags: []
      availableTimesOfDay: 
      isRepeatable: 1
      flagsToAdd: []
      flagsToRemove: []
      targetDialogueIndex: -1
      response:
        speakerName: Mbok Randa Krandon
        responseText: Maka kamu akan membuat musuh yang sangat kuat. Tapi... aku
          percaya pada penilaian Ki Ageng terhadap karakter.
        conversationBubbleSprite: {fileID: 0}
        pauseAfterResponse: 0
        continueToNext: 1
        nextDialogueIndex: -1
      questToStart: 
      questToComplete: 
      objectiveToComplete: 
      questForObjective: 
      isImportantChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 0
    pauseAfterDialogue: 0
  - speakerName: Mbok Randa Krandon
    dialogueText: KAMU! Kamu menipu aku! Di mana gajah putihku? Apa yang telah kamu
      lakukan padanya?
    availableTimesOfDay: 
    isRepeatable: 1
    requiredFlags:
    - elephant_sacrifice_revealed
    hasChoices: 1
    choices:
    - choiceText: Saya bisa menjelaskan semuanya...
      requiredFlags: []
      availableTimesOfDay: 
      isRepeatable: 1
      flagsToAdd:
      - attempted_explanation
      flagsToRemove: []
      targetDialogueIndex: -1
      response:
        speakerName: Mbok Randa Krandon
        responseText: Menjelaskan? MENJELASKAN?! Kamu mengambil gajah kesayanganku
          dan... dan... Aku tidak seharusnya mempercayai murid padepokan!
        conversationBubbleSprite: {fileID: 0}
        pauseAfterResponse: 0
        continueToNext: 1
        nextDialogueIndex: -1
      questToStart: 
      questToComplete: 
      objectiveToComplete: 
      questForObjective: 
      isImportantChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    - choiceText: Ini demi kebaikan banyak orang
      requiredFlags: []
      availableTimesOfDay: 
      isRepeatable: 1
      flagsToAdd:
      - justified_actions
      flagsToRemove: []
      targetDialogueIndex: -1
      response:
        speakerName: Mbok Randa Krandon
        responseText: Kebaikan banyak orang? Bagaimana dengan kehilanganKU? Bagaimana
          dengan rasa sakitKU? Tangkap dia! Jangan biarkan dia kabur!
        conversationBubbleSprite: {fileID: 0}
        pauseAfterResponse: 0
        continueToNext: 1
        nextDialogueIndex: -1
      questToStart: 
      questToComplete: 
      objectiveToComplete: 
      questForObjective: 
      isImportantChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 1
    pauseAfterDialogue: 0
  greetings: []
  farewells: []
  defaultConversationBubble: {fileID: 0}
  loopDialogue: 0
  canBeInterrupted: 1
  dialogueStartSound: {fileID: 0}
  typewriterSound: {fileID: 0}
