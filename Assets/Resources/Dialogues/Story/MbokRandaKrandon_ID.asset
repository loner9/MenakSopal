  npcName: Mbok Randa Krandon
  dialogueDescription: Pemilik gajah putih, mewakili konflik dan pemahaman akhir
  dialogueEntries:
  - speakerName: Mbok Randa Krandon
    dialogueText: Siang. Siapa kalian datang ke gubukku yang sederhana ini, wahai
      anak muda?
    availableTimesOfDay: 
    isRepeatable: 0
    requiredFlags: []
    flagsToAdd: []
    flagsToRemove: []
    hasChoices: 1
    choices:
    - choiceText: Menjelaskan
      requiredFlags: []
      availableTimesOfDay: 
      isRepeatable: 0
      flagsToAdd: []
      flagsToRemove: []
      targetDialogueIndex: 0
      response:
        speakerName: Menak Sopal
        responseText: Kami dari Padepokan Sinawang mbok. Saya Menak Sopal, dan itu
          rekan saya, paman Joko.
        conversationBubbleSprite: {fileID: 0}
        pauseAfterResponse: 0
        continueToNext: 1
        nextDialogueIndex: 1
      questToStart: 
      questToComplete: 
      objectiveToComplete: 
      questForObjective: 
      isImportantChoice: 0
      choiceColor: {r: 0, g: 0, b: 0, a: 0}
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 0
    pauseAfterDialogue: 0
  - speakerName: Mbok Randa Krandon
    dialogueText: Padepokan Sinawang, jauh juga. Ada maksud apa kalian kesini?
    availableTimesOfDay: 
    isRepeatable: 0
    requiredFlags: []
    flagsToAdd: []
    flagsToRemove: []
    hasChoices: 1
    choices:
    - choiceText: Meminjam Gajah
      requiredFlags: []
      availableTimesOfDay: 
      isRepeatable: 0
      flagsToAdd: []
      flagsToRemove: []
      targetDialogueIndex: 0
      response:
        speakerName: Menak Sopal
        responseText: Begini mbok, kami ingin meminjam Gajah Putih panjengengan.
        conversationBubbleSprite: {fileID: 0}
        pauseAfterResponse: 0
        continueToNext: 1
        nextDialogueIndex: 2
      questToStart: 
      questToComplete: 
      objectiveToComplete: 
      questForObjective: 
      isImportantChoice: 0
      choiceColor: {r: 0, g: 0, b: 0, a: 0}
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 0
    pauseAfterDialogue: 0
  - speakerName: Mbok Randa Krandon
    dialogueText: Untuk apa, biasanya Ki Ageng bersurat dulu kepadaku jika ada sesuatu
    availableTimesOfDay: 
    isRepeatable: 0
    requiredFlags: []
    flagsToAdd: []
    flagsToRemove: []
    hasChoices: 1
    choices:
    - choiceText: Berbohong
      requiredFlags: []
      availableTimesOfDay: 
      isRepeatable: 0
      flagsToAdd: []
      flagsToRemove: []
      targetDialogueIndex: 0
      response:
        speakerName: Menak Sopal
        responseText: Umm, anu mbok di, di dekat padepokan ada festival. Kami ingin
          menggunakan Gajah Putih untuk pertunjukan. Hanya 3 hari saja...
        conversationBubbleSprite: {fileID: 0}
        pauseAfterResponse: 0
        continueToNext: 1
        nextDialogueIndex: 3
      questToStart: 
      questToComplete: 
      objectiveToComplete: 
      questForObjective: 
      isImportantChoice: 0
      choiceColor: {r: 0, g: 0, b: 0, a: 0}
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 0
    pauseAfterDialogue: 0
  - speakerName: Mbok Randa Krandon
    dialogueText: Baiklah, karena aku kenal baik dengan Ki Ageng, bawalah gajahku.
