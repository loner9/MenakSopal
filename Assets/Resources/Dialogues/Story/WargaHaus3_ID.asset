    flagsToRemove: []
    hasChoices: 0
    choices: []
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 0
    pauseAfterDialogue: 0
  - speakerName: Karto
    dialogueText: Cukup kisah asmaraku saja yang kering, tak perlu sumber sumber
      air disekitar pemukiman ini yang kering. Hal ini membuatku benar benar frustasi
      nak!
