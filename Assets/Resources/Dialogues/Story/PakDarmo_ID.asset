  m_Script: {fileID: 11500000, guid: 6ee7b598c5ab3ff4ca2f90f31e9bc917, type: 3}
  m_Name: PakDarmo_ID
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  npcName: Pak Darmo
  dialogueDescription: Warga yang menderita krisis air
  dialogueEntries:
  - speakerName: Pak Darmo
    dialogueText: Tolong, nak muda! sudah berhari-hari kami kesulitan mendapat air
      bersih! Sumur ini hampir kering!
    availableTimesOfDay: 00000000020000000300000001000000
    isRepeatable: 0
    requiredFlags: []
    flagsToAdd:
    - water_crisis_discovered
    flagsToRemove: []
    hasChoices: 1
    choices:
    - choiceText: Bertanya tentang sungai
      requiredFlags: []
      availableTimesOfDay: 
      isRepeatable: 1
      flagsToAdd:
      - river_asked
      flagsToRemove: []
      targetDialogueIndex: -1
      response:
        speakerName: Menak Sopal
        responseText: Saya dengar ada sungai disekitar desa ini pak, mengapa tidak
          mengambil air dari sana??
        conversationBubbleSprite: {fileID: 0}
        pauseAfterResponse: 0
        continueToNext: 1
        nextDialogueIndex: 1
      questToStart: 
      questToComplete: 
      objectiveToComplete: 
      questForObjective: 
      isImportantChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 1
    pauseAfterDialogue: 0
  - speakerName: Pak Darmo
    dialogueText: Kami sudah mencoba mengambil air, tetapi sungai mulai kering. Air
      dari hulu tidak sampai ke tempat kami biasa mengambil air. Banyak bahaya di
      tempat tersebut.
    availableTimesOfDay: 000000000200000001000000
    isRepeatable: 0
    requiredFlags: []
    flagsToAdd:
    - water_crisis_discovered
    flagsToRemove: []
    hasChoices: 1
    choices:
    - choiceText: Aku paham
      requiredFlags: []
      availableTimesOfDay: 
      isRepeatable: 1
      flagsToAdd: []
      flagsToRemove: []
      targetDialogueIndex: -1
      response:
        speakerName: Menak Sopal
        responseText: Kami dari padepokan belum bisa banyak membantu karena juga
          kesulitan air. Terima kasih atas informasinya, pak.
        conversationBubbleSprite: {fileID: 0}
        pauseAfterResponse: 0
        continueToNext: 0
        nextDialogueIndex: -1
      questToStart: 
      questToComplete: 
      objectiveToComplete: witness_crisis
      questForObjective: water_crisis_discovery
      isImportantChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 1
    pauseAfterDialogue: 0
  - speakerName: Pak Darmo
    dialogueText: Iya nak, kasihanilah orang tua renta seperti kami ini...
    availableTimesOfDay: 0000000001000000
    isRepeatable: 0
    requiredFlags:
    - kegaduhan
    flagsToAdd: []
    flagsToRemove: []
    hasChoices: 0
    choices: []
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 0
    pauseAfterDialogue: 0
