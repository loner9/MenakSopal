  m_Script: {fileID: 11500000, guid: 6ee7b598c5ab3ff4ca2f90f31e9bc917, type: 3}
  m_Name: BuayaPutih_ID
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  npcName: Buaya Putih
  dialogueDescription: Penjaga mistis, mewakili tuntutan alam dan kerjasama akhir
  dialogueEntries:
  - speakerName: Buaya Putih
    dialogueText: Siapa yang berani beraninya mengganggu istirahatku!
    availableTimesOfDay: 000000000200000003000000
    isRepeatable: 0
    requiredFlags:
    - spiritual_vision_active
    flagsToAdd: []
    flagsToRemove: []
    hasChoices: 1
    choices:
    - choiceText: Menak Sopal
      requiredFlags: []
      availableTimesOfDay: 
      isRepeatable: 1
      flagsToAdd: []
      flagsToRemove: []
      targetDialogueIndex: -1
      response:
        speakerName: Menak Sopal
        responseText: Aku, Menak Sopal. Murid dari padepokan Sinawang!. Hendak mencari
          alasan bendunganku hancur berkali kali
        conversationBubbleSprite: {fileID: 0}
        pauseAfterResponse: 0
        continueToNext: 1
        nextDialogueIndex: 4
      questToStart: 
      questToComplete: 
      objectiveToComplete: 
      questForObjective: 
      isImportantChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 1
    pauseAfterDialogue: 0
  - speakerName: Buaya Putih
    dialogueText: Jika kamu ingin bendunganmu berdiri, kamu harus menawarkan persembahan
      yang layak. Bawakan aku kepala gajah putih, dan aku akan menghentikan kerusakanku.
    availableTimesOfDay: 000000000200000003000000
    isRepeatable: 0
    requiredFlags: []
    flagsToAdd: []
    flagsToRemove: []
    hasChoices: 1
    choices:
    - choiceText: Menerima
      requiredFlags: []
      availableTimesOfDay: 
      isRepeatable: 1
      flagsToAdd:
      - accepted_spirit_demand
      flagsToRemove: []
      targetDialogueIndex: -1
      response:
        speakerName: Menak Sopal
        responseText: Baiklah, saya akan mencari gajah putih ini
        conversationBubbleSprite: {fileID: 0}
        pauseAfterResponse: 0
        continueToNext: 1
        nextDialogueIndex: -1
      questToStart: 
      questToComplete: 
      objectiveToComplete: 
      questForObjective: 
      isImportantChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 1
    pauseAfterDialogue: 0
  - speakerName: Buaya Putih
    dialogueText: Permintaanku telah terpenuhi. Bendunganmu akan berdiri, dan aku
      tak akan menggagu lagi.
    availableTimesOfDay: 000000000200000003000000
    isRepeatable: 1
    requiredFlags:
    - elephant_sacrifice_complete
    flagsToAdd:
    - spirit_pact_complete
    flagsToRemove: []
    hasChoices: 0
    choices: []
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 1
    pauseAfterDialogue: 0
  - speakerName: Buaya Putih
    dialogueText: Anak muda yang menghormati cara-cara kuno, aku tidak akan membiarkanmu
      tenggelam. Hatimu yang murni telah mendapat perlindunganku.
    availableTimesOfDay: 000000000200000003000000
    isRepeatable: 1
    requiredFlags:
    - drowning_in_river
    flagsToAdd:
    - rescued_by_crocodile
    flagsToRemove: []
    hasChoices: 0
    choices: []
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 1
    pauseAfterDialogue: 0
  - speakerName: Buaya Putih
    dialogueText: Hmm, jadi muara gemuruh gaduh dari tempat istirahatku akhir akhir
      ini adalah ulahmu!. Berulang kali ku redam namun tak kunjung padam juga, apa
      kau ingin menantangku nak?!
    availableTimesOfDay: 000000000200000003000000
    isRepeatable: 1
    requiredFlags: []
    flagsToAdd: []
    flagsToRemove: []
    hasChoices: 1
    choices:
    - choiceText: Menjelaskan
      requiredFlags: []
      availableTimesOfDay: 
      isRepeatable: 1
      flagsToAdd: []
      flagsToRemove: []
      targetDialogueIndex: -1
      response:
        speakerName: Menak Sopal
        responseText: Tidak, aku tidak berniat menggagumu wahai penunggu tempat ini.
          Aku hanya ingin membantu hajat banyak orang dengan membangun bendungan
          ini.
        conversationBubbleSprite: {fileID: 0}
        pauseAfterResponse: 0
        continueToNext: 1
        nextDialogueIndex: 1
      questToStart: 
      questToComplete: 
      objectiveToComplete: 
      questForObjective: 
      isImportantChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 1
    pauseAfterDialogue: 0
  - speakerName: Buaya Putih
    dialogueText: 'Begitu rupanya. Kali ini aku sedang dalam suasana baik. Tapi ingat,
      lain kali izinlah terlebih dahulu dimanapun kau berpijak. '
    availableTimesOfDay: 000000000200000003000000
    isRepeatable: 1
    requiredFlags: []
    flagsToAdd: []
    flagsToRemove: []
    hasChoices: 0
    choices: []
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 1
    pauseAfterDialogue: 0
  greetings: []
  farewells: []
  defaultConversationBubble: {fileID: 0}
  loopDialogue: 0
  canBeInterrupted: 1
  dialogueStartSound: {fileID: 0}
  typewriterSound: {fileID: 0}
