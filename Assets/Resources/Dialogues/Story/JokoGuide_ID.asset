  m_Name: JokoGuide_ID
  m_EditorClassIdentifier: 
  npcName: Joko (Penunjuk Jalan Desa)
  dialogueDescription: Pemandu perjalanan ke Desa Krandon
  dialogueEntries:
  - speakerName: Joko
    dialogueText: Aku tahu jalan ke Desa Krandon, pal. Aku bisa memberitahumu arah
      untuk mencapai desa itu!
    availableTimesOfDay: 0000000002000000
    isRepeatable: 0
    requiredFlags:
    - seeking_white_elephant
    flagsToAdd: []
    flagsToRemove: []
    hasChoices: 1
    choices: []
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 0
    pauseAfterDialogue: 0
  - speakerName: Joko
    dialogueText: Hei nak, kau seperti dalam masalah. Ada hal yang bisa ku bantu?
    availableTimesOfDay: 000000000200000001000000
    isRepeatable: 0
    requiredFlags:
    - committed_to_help
    - guru_guidance_received
    flagsToAdd: []
    flagsToRemove: []
    hasChoices: 1
    choices:
    - choiceText: Meminta bantuan
      requiredFlags: []
      availableTimesOfDay: 
      isRepeatable: 0
      flagsToAdd: []
      flagsToRemove: []
      targetDialogueIndex: -1
      response:
        speakerName: Menak Sopal
        responseText: Paman Joko, bersediakah engkau untuk membantuku dalam membangun
          dam untuk membantu krisis air di pemukiman ini?
        conversationBubbleSprite: {fileID: 0}
        pauseAfterResponse: 0
        continueToNext: 1
        nextDialogueIndex: 2
      questToStart: journey_to_krandon
      questToComplete: 
      objectiveToComplete: 
      questForObjective: 
      isImportantChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 0
    pauseAfterDialogue: 0
  - speakerName: Joko
    dialogueText: Oh, tentu saja nak!. Krisis air ini telah membuat gaduh kehidupan
      orang orang disini!. Pun ke sungai, air tidak sampai di tempat yang aman bagi
      kami. Bersama keahlianmu, pastinya membangun dam ini menjadi lebih aman hahaha.
    availableTimesOfDay: 0000000002000000
    isRepeatable: 0
    requiredFlags:
    - committed_to_help
    flagsToAdd: []
    flagsToRemove: []
    hasChoices: 0
    choices: []
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 0
    pauseAfterDialogue: 0
  - speakerName: Joko
    dialogueText: Ayo nak, saatnya kita bangun dam ini!
    availableTimesOfDay: 0000000002000000
    isRepeatable: 0
    requiredFlags:
    - to_river
    flagsToAdd: []
    flagsToRemove: []
    hasChoices: 1
    choices: []
    conversationBubbleSprite: {fileID: 0}
    isImportantDialogue: 0
    pauseAfterDialogue: 0
  greetings:
  - speakerName: Joko
    dialogueText: Ah, halo nak
